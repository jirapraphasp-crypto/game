<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>ลูกอมพลังเหาะ – เกมจับโม้โฆษณา</title>
<style>
:root{--bg:#fff3b8;--ink:#2b1160;--card:#fff;--purple:#6a2fd0;--pink:#ff3d8b;--red:#e6212b;--green:#1fae5b;--yel:#ffd21f;color-scheme:light}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#2a1456;--ink:#fff3b8;--card:#3b1d78;color-scheme:dark}}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%}
:root{padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
body{background:var(--bg);color:var(--ink);font-family:"Noto Sans Thai Looped","Sarabun","Thonburi",system-ui,sans-serif;text-align:center;padding:14px 14px 30px;max-width:520px;margin:auto}
h1,h2{margin:0}
.bag{background:linear-gradient(160deg,#7a35e0,#4b1aa0);border-radius:22px;padding:16px;border:4px solid var(--yel);transform:rotate(-1.5deg);box-shadow:0 6px 0 #2b1160}
.bag .big{font-size:34px;font-weight:900;color:var(--yel);line-height:1.2;-webkit-text-stroke:1px #2b1160}
.bag .pink{font-size:30px;font-weight:900;color:#ff7fb5;line-height:1.2}
.face{font-size:64px;line-height:1.1;margin:6px 0}
.shout{font-size:26px;font-weight:900;color:var(--red);margin:14px 0 4px;line-height:1.3}
.facts{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin:10px 0}
.facts span{background:var(--card);border:3px solid var(--purple);border-radius:999px;padding:6px 12px;font-weight:700;font-size:16px}
button{font:inherit;cursor:pointer;border:0;border-radius:18px;font-weight:900;color:#fff;padding:14px 18px;font-size:22px;box-shadow:0 5px 0 rgba(0,0,0,.3)}
button:active{transform:translateY(4px);box-shadow:0 1px 0 rgba(0,0,0,.3)}
button:focus-visible{outline:4px solid var(--ink);outline-offset:3px}
.go{background:var(--pink);width:100%;margin-top:12px;font-size:26px}
.bar{display:flex;justify-content:space-between;font-weight:900;font-size:18px;margin-bottom:8px}
.claim{background:var(--card);border:4px solid var(--purple);border-radius:22px;padding:20px 12px;min-height:150px;display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:900;line-height:1.35;color:var(--red)}
.claim.true{color:var(--ink)}
.btns{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:14px}
.t{background:var(--green)}.f{background:var(--red)}
.msg{min-height:84px;margin-top:12px;font-size:20px;font-weight:700;line-height:1.4}
.next{background:var(--purple);width:100%}
.hide{display:none}
.stars{font-size:40px;letter-spacing:4px;margin:8px 0}
.tip{background:var(--card);border-radius:18px;padding:12px;font-size:19px;font-weight:700;line-height:1.5;margin-top:10px;border:3px dashed var(--pink)}
.shake{animation:sh .35s}
@keyframes sh{25%{transform:translateX(-8px)}75%{transform:translateX(8px)}}
@media (prefers-reduced-motion:reduce){.shake{animation:none}}
</style>
</head>
<body>

<section id="intro">
  <div class="bag">
    <div class="big">ลูกอมพลังเหาะ</div>
    <div class="face">🤩🍬</div>
    <div class="pink">อมแล้ว… เป็นอะไรก็ได้!</div>
  </div>
  <div class="shout">บินก็ได้! ว่ายน้ำก็ได้!<br>เก่งที่สุดในโลก! แค่อมเม็ดเดียว!</div>
  <div class="facts"><span>🍊 รสส้ม</span><span>🍬 1 ถุงมี 10 เม็ด</span><span>💜 ถุงสีม่วง</span></div>
  <h2 style="font-size:22px;margin-top:8px">เกมจับโม้ 🕵️</h2>
  <p style="font-size:19px;font-weight:700;margin:6px 0">อ่านโฆษณา แล้วบอกว่า<br><b style="color:var(--green)">จริง ✅</b> หรือ <b style="color:var(--red)">โม้ 🤥</b></p>
  <button class="go" id="start">เริ่มเล่น!</button>
</section>

<section id="game" class="hide">
  <div class="bar"><span id="rnd">ข้อ 1/10</span><span id="sc">⭐ 0</span></div>
  <div class="claim" id="claim"></div>
  <div class="btns">
    <button class="t" id="bT">จริง ✅</button>
    <button class="f" id="bF">โม้ 🤥</button>
  </div>
  <div class="msg" id="msg"></div>
  <button class="next hide" id="nx">ข้อต่อไป ▶</button>
</section>

<section id="end" class="hide">
  <div class="face" id="medal">🏆</div>
  <h2 id="title" style="font-size:30px"></h2>
  <div class="stars" id="stars"></div>
  <p style="font-size:22px;font-weight:900" id="final"></p>
  <div class="tip">💡 โฆษณาชอบพูดเกินจริงเพื่อให้เราอยากซื้อ<br>ลูกอมไม่มีพลังวิเศษ กินแล้วบินไม่ได้นะ!<br>ก่อนเชื่อ ให้ถามตัวเองว่า <b>“เป็นไปได้จริงไหม?”</b></div>
  <button class="go" id="again">เล่นอีกครั้ง 🔄</button>
</section>

<script>
const Q=[
 ["ลูกอมนี้มีรสส้ม 🍊",1,"จริง! เขียนไว้บนถุงเลย"],
 ["อมแล้วบินได้เหมือนซูเปอร์แมน! 🦸",0,"โม้! ลูกอมทำให้คนบินไม่ได้"],
 ["ใน 1 ถุงมีลูกอม 10 เม็ด 🍬",1,"จริง! บอกไว้ข้างถุงแล้ว"],
 ["อมเม็ดเดียว ว่ายน้ำเร็วกว่าปลาโลมา! 🐬",0,"โม้! ต้องฝึกว่ายน้ำ ไม่ใช่กินลูกอม"],
 ["ถุงของลูกอมนี้เป็นสีม่วง 💜",1,"จริง! ดูรูปถุงได้เลย"],
 ["กินแล้วสอบได้ที่ 1 ทุกวิชา! 💯",0,"โม้! ต้องตั้งใจเรียนและอ่านหนังสือ"],
 ["กินแล้ววิ่งเร็วกว่าเสือชีตาห์! 🐆",0,"โม้! ลูกอมไม่ทำให้วิ่งเร็วขนาดนั้น"],
 ["กินแล้วตัวสูงเท่าตึกสูงๆ! 🏢",0,"โม้! กินขนมไม่ทำให้ตัวสูงขนาดนั้น"],
 ["กินแล้วไม่ต้องนอนอีกเลยตลอดชีวิต! 🌙",0,"โม้! ทุกคนต้องนอนเพื่อให้ร่างกายแข็งแรง"],
 ["กินแล้วทุกคนบนโลกรักเรา! 💖",0,"โม้! เพื่อนรักเพราะเราเป็นคนดี ไม่ใช่เพราะลูกอม"],
 ["ลูกอมนี้ชื่อ “ลูกอมพลังเหาะ” 🍬",1,"จริง! ชื่ออยู่บนหน้าถุงเลย"],
 ["อมแล้วหายตัวได้เหมือนนินจา! 🥷",0,"โม้! ลูกอมไม่ทำให้หายตัวได้"],
 ["กินลูกอมเยอะๆ ทำให้ฟันผุได้ 🦷",1,"จริง! กินหวานแล้วต้องแปรงฟันนะ"],
 ["กินแล้วยกรถบัสได้ด้วยมือเดียว! 🚌",0,"โม้! ลูกอมไม่ได้ทำให้แข็งแรงขนาดนั้น"],
 ["กินแล้วพูดภาษาสัตว์ได้ทุกภาษา! 🐘",0,"โม้! ไม่มีขนมไหนทำให้พูดภาษาสัตว์ได้"],
 ["บนถุงมีรูปเด็กหน้าตายิ้มดีใจ 🤩",1,"จริง! ดูหน้าถุงได้เลย"],
 ["กินแล้วกระโดดไปดวงจันทร์ได้! 🌙🚀",0,"โม้! ต้องใช้จรวด ไม่ใช่ลูกอม"],
 ["ลูกอมเป็นขนมหวาน ไม่ใช่ยา 🍭",1,"จริง! ลูกอมเป็นขนม ไม่ได้รักษาโรค"],
 ["อมแล้วไม่เคยป่วยไปตลอดชีวิต! 🛡️",0,"โม้! ต้องกินอาหารดี ออกกำลังกาย และนอนหลับ"],
 ["อมแล้วเป็นหมอ เป็นครู เป็นนักบินได้ทันที! 👩‍⚕️",0,"โม้! อาชีพต้องเรียนและฝึกหลายปี"]
];
const $=id=>document.getElementById(id);
let i,s,locked,order;
function show(id){["intro","game","end"].forEach(x=>$(x).classList.toggle("hide",x!==id))}
function shuffle(a){for(let k=a.length-1;k>0;k--){const j=Math.floor(Math.random()*(k+1));[a[k],a[j]]=[a[j],a[k]]}return a}
function start(){order=shuffle(Q.slice());i=0;s=0;show("game");load()}
function load(){
  locked=false;const q=order[i];
  $("rnd").textContent="ข้อ "+(i+1)+"/"+order.length;$("sc").textContent="⭐ "+s;
  $("claim").textContent=q[0];$("claim").className="claim"+(q[1]?" true":"");
  $("msg").textContent="";$("nx").classList.add("hide");
  $("bT").disabled=$("bF").disabled=false;
}
function ans(v){
  if(locked)return;locked=true;
  const q=order[i],ok=(v===q[1]);
  if(ok)s++;else $("claim").classList.add("shake");
  $("msg").innerHTML=(ok?"🎉 เก่งมาก! ":"😅 ยังไม่ถูกนะ ")+q[2];
  $("msg").style.color=ok?"var(--green)":"var(--red)";
  $("sc").textContent="⭐ "+s;
  $("bT").disabled=$("bF").disabled=true;
  $("nx").textContent=i===order.length-1?"ดูคะแนน 🏆":"ข้อต่อไป ▶";
  $("nx").classList.remove("hide");
}
function next(){i++;if(i>=order.length)finish();else load()}
function finish(){
  show("end");const n=order.length;
  $("final").textContent="ได้ "+s+" จาก "+n+" คะแนน";
  $("stars").textContent="⭐".repeat(Math.round(s/n*5))||"🌱";
  $("title").textContent=s/n>=0.9?"นักสืบจับโม้ตัวจริง!":s/n>=0.6?"เก่งมาก ใกล้เป็นนักสืบแล้ว!":"ลองเล่นอีกครั้งนะ สู้ๆ!";
  $("medal").textContent=s/n>=0.9?"🏆":s/n>=0.6?"🥈":"🌟";
}
$("start").onclick=start;$("again").onclick=start;$("nx").onclick=next;
$("bT").onclick=()=>ans(1);$("bF").onclick=()=>ans(0);
</script>
</body>
</html>